    { "source": "/habitaciones", "destination": "https://alquilerporhabitaciones.vercel.app/habitaciones" },
    { "source": "/habitaciones/:path*", "destination": "https://alquilerporhabitaciones.vercel.app/habitaciones/:path*" },

    { "source": "/turistico", "destination": "https://alquilerturistico.vercel.app/turistico" },
    { "source": "/turistico/:path*", "destination": "https://alquilerturistico.vercel.app/turistico/:path*" }
  ]
}
